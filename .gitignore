# Python
__pycache__/
*.py[co]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Éditeurs et système
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets. Aucun n'est utilisé par ce dépôt, mais un fichier de ce type posé
# par erreur ne doit jamais partir.
.env
.env.*
*.pem
*.key
*.crt
id_rsa*
id_ed25519*
secrets/
credentials/

# Configuration réelle de la supervision : elle contient le nom du canal ntfy,
# qui fait office de secret. Seul le fichier .exemple est versionné.
honeypot-supervision.conf

# Journaux bruts et artefacts récupérés sur le honeypot : jamais versionnés.
# Les journaux sont publiés à part, préparés, dans une release GitHub (voir
# docs/donnees.md). Les binaires déposés par les attaquants ne sont jamais
# publiés.
cowrie.json*
cowrie.log*
archive_*.json.gz
*.log
downloads/
tty/
*.pcap
*.pcapng
logs/
data/

# Sorties par défaut des scripts, à régénérer plutôt qu'à versionner.
# Les instantanés que l'on garde sont nommés et rangés dans resultats/.
/stats.json
demo/stats.json

# Le jeu synthétique est le seul fichier JSON d'événements autorisé
!sample-data/cowrie.json.exemple
